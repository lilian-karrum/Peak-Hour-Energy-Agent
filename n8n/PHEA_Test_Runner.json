        [
          {
            "node": "Write to Sheets?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Run Day Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Day Agent": {
      "main": [
        [
          {
            "node": "Simulator Score (run_summary)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Simulator Score (run_summary)": {
      "main": [
        [
          {
            "node": "Combine Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Combine Result": {
      "main": [
        [
          {
            "node": "Loop Days",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write to Sheets?": {
      "main": [
        [
          {
            "node": "Google Sheets: Test_Results",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Results Table",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets: Test_Results": {
      "main": [
        [
          {
            "node": "Results Table",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}